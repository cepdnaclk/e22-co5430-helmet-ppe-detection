# Python cache
__pycache__/
*.py[cod]
*$py.class

# Virtual environments
venv/
env/
.venv/

# Jupyter Notebook checkpoints
.ipynb_checkpoints/

# Model weights (large files)
*.pt
*.pth
*.h5
*.onnx

# Dataset files (usually large)
dataset/*
!dataset/.gitkeep

# Results generated by experiments
results/images/*
results/metrics/*
!results/images/.gitkeep
!results/metrics/.gitkeep

# IDE files
.vscode/
.idea/

# OS files
.DS_Store
Thumbs.db

# Logs
*.log